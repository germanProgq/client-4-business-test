# Copy to .env for local (non-docker) runs.

# Async DSN used by the running app (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://approval:approval@localhost:5432/approval_service

# Sync DSN used only by Alembic migrations (psycopg2 driver).
DATABASE_URL_SYNC=postgresql+psycopg2://approval:approval@localhost:5432/approval_service

ENVIRONMENT=local
LOG_LEVEL=INFO

# How often the outbox dispatcher polls for unpublished events, in seconds.
OUTBOX_POLL_INTERVAL_SECONDS=2
